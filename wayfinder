      }

      @media (min-width: 681px) and (max-width: 820px) {
        .navbar { gap: 8px; padding: 0 12px; }
        .nav-links { gap: 2px; }
        .nav-links > a, .nav-dropdown > summary { padding: 8px 4px; font-size: 14px; }
        .button { padding: 8px 10px; font-size: 14px; }
      }

      @container components (max-width: 680px) {
        .menu-visuals { grid-template-columns: minmax(0, 1fr); }
        .feature-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
        .tab-detail-grid { grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); }
