                    { "label": "Contacts", "href": "#contacts" }
                  ]
                }
              ]
            },
            {
              "label": "More",
              "type": "mega-menu",
              "title": "Explore every section",
              "items": [
                {
                  "label": "Components",
                  "items": [
                    { "label": "Dropdown and mega menu", "href": "#menus" },
                    { "label": "Tabs", "href": "#tabs" },
                    { "label": "Breadcrumbs", "href": "#breadcrumbs" },
                    { "label": "Menu schema", "href": "#schema" }
                  ]
                },
                {
                  "label": "Website directory",
                  "items": [
                    { "label": "All websites", "href": "#websites" },
                    { "label": "Reference & video", "href": "#reference-links" },
                    { "label": "Shopping", "href": "#shopping-links" },
                    { "label": "Browsers", "href": "#browser-links" },
                    { "label": "AI tools", "href": "#ai-links" }
                  ]
                },
                {
                  "label": "About Wayfinder",
                  "items": [
                    { "label": "Features and About", "href": "#about" },
                    { "label": "Reviews and ratings", "href": "#reviews" },
                    { "label": "Contacts", "href": "#contacts" }
                  ]
                }
              ]
            },
            { "label": "Websites", "href": "#websites" },
            { "label": "Contact", "href": "#contacts" },
            { "label": "About", "href": "#about" },
            { "label": "Reviews", "href": "#reviews" }
          ]
        }
      ],
      "contacts": [
        {
          "name": "Akshata Agrawal",
          "phone": "7247295540",
          "address": "MITS Gwalior"
        },
        {
          "name": "Vivek Barauliya",
          "address": "MITS Gwalior"
        }
      ]
    }
  </script>
  <script>
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    if (!window.location.hash) window.scrollTo(0, 0);

    const configElement = document.querySelector("#navigation-config");
    const fallbackConfig = JSON.parse(configElement.textContent);
    const primaryNav = document.querySelector("#primary-nav");
    const mobileNav = document.querySelector("#mobile-nav");
    const sidebarNav = document.querySelector("#sidebar-links");
    const contactList = document.querySelector("#contact-list");
    const drawerToggle = document.querySelector("#drawer-toggle");
    const aboutCopy = document.querySelector("#about-copy");
    const aboutSaveStatus = document.querySelector("#about-save-status");
    const aboutStorageKey = "navigation-about-copy";
    const reviewForm = document.querySelector("#review-form");
    const reviewText = document.querySelector("#review-text");
    const reviewStatus = document.querySelector("#review-status");
    const reviewList = document.querySelector("#review-list");
    const reviewAverage = document.querySelector("#review-average");
    const reviewStars = document.querySelector("#review-stars");
    const reviewCount = document.querySelector("#review-count");
    const ratingFeedback = document.querySelector("#rating-feedback");
    const reviewStorageKey = "wayfinder-reviews";
    const reviewRatings = {
      1: { emoji: "😞", label: "Could improve" },
      2: { emoji: "😐", label: "Just okay" },
      3: { emoji: "🙂", label: "Good" },
      4: { emoji: "😄", label: "Great" },
      5: { emoji: "🤩", label: "Loved it" }
    };
    let savedReviews = [];
    let reviewStorageReady = true;

    document.querySelector(".locate-link").addEventListener("click", () => {
      const siteHeader = document.querySelector("#site-home");
      siteHeader.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
      });
      siteHeader.focus({ preventScroll: true });
    });

    function safeHref(value) {
      return typeof value === "string" &&
        (value.startsWith("#") || (value.startsWith("/") && !value.startsWith("//")));
    }

    function createLink(item) {
      if (!item || typeof item.label !== "string" || !safeHref(item.href)) return null;

      const link = document.createElement("a");
      link.href = item.href;
      link.textContent = item.label;
      return link;
    }

    function createMenuList(items) {
      const list = document.createElement("ul");
      items.forEach(item => {
        if (!item || typeof item.label !== "string") return;

        const entry = document.createElement("li");
        if (Array.isArray(item.items)) {
          entry.className = "menu-group";
          const heading = document.createElement("h3");
          heading.textContent = item.label;
          entry.append(heading, createMenuList(item.items));
        } else {
          const link = createLink(item);
          if (!link) return;
          entry.append(link);
        }
        list.append(entry);
      });
      return list;
    }

    function createNavItem(item) {
      if (!item || typeof item.label !== "string") return null;
      if (!Array.isArray(item.items)) return createLink(item);

      const group = document.createElement("details");
      group.className = "nav-dropdown";

      const summary = document.createElement("summary");
      summary.textContent = item.label;

      const menu = document.createElement("div");
      menu.className = item.type === "mega-menu" ? "dropdown-menu mega-menu" : "dropdown-menu";
      if (item.type === "mega-menu") {
        const heading = document.createElement("h2");
        heading.textContent = item.title || item.label;
        menu.append(heading);
      }

      menu.append(createMenuList(item.items));
      group.append(summary, menu);
      return group;
    }

    function renderLinks(container, items, builder) {
      container.replaceChildren();
      items.forEach(item => {
        const element = builder(item);
        if (element) container.append(element);
      });
    }

    function renderContacts(contacts) {
      contactList.replaceChildren();
      contacts.forEach(person => {
        if (!person || typeof person.name !== "string" || typeof person.address !== "string") return;

        const card = document.createElement("section");
        card.className = "contact-card";
        const name = document.createElement("h3");
        name.textContent = person.name;
        card.append(name);

        if (typeof person.phone === "string" && /^\d+$/.test(person.phone)) {
          const phone = document.createElement("a");
          phone.href = `tel:${person.phone}`;
          phone.textContent = person.phone;
          const phoneLine = document.createElement("p");
          phoneLine.append(phone);
          card.append(phoneLine);
        }

        const address = document.createElement("address");
        address.textContent = person.address;
        card.append(address);
        contactList.append(card);
      });
    }

    function isNavigationConfig(value) {
      return value && Array.isArray(value.menus) &&
        value.menus.some(menu => menu && menu.location === "header" && Array.isArray(menu.items));
    }

    function renderNavigation(config) {
      const header = config.menus.find(menu => menu.location === "header");
      const sidebar = config.menus.find(menu => menu.location === "sidebar");
      const drawer = config.menus.find(menu => menu.location === "drawer");

      if (!header || !Array.isArray(header.items)) return;
      renderLinks(primaryNav, header.items, createNavItem);
      if (drawer && typeof drawer.id === "string" && /^[A-Za-z][A-Za-z0-9_-]*$/.test(drawer.id)) {
        mobileNav.id = drawer.id;
        drawerToggle.setAttribute("aria-controls", drawer.id);
        document.querySelector(".menu-button").setAttribute("aria-controls", drawer.id);
      }
      if (drawer && typeof drawer.toggle_id === "string" && /^[A-Za-z][A-Za-z0-9_-]*$/.test(drawer.toggle_id)) {
        drawerToggle.id = drawer.toggle_id;
        document.querySelector(".menu-button").htmlFor = drawer.toggle_id;
        document.querySelector(".drawer-backdrop").htmlFor = drawer.toggle_id;
      }
      renderLinks(mobileNav, drawer && Array.isArray(drawer.items) ? drawer.items : header.items, createNavItem);
      if (sidebar && Array.isArray(sidebar.items)) {
        renderLinks(sidebarNav, sidebar.items, createLink);
      }
      renderContacts(Array.isArray(config.contacts) ? config.contacts : fallbackConfig.contacts);
      updateActiveLinks();
    }

    function updateActiveLinks(target = window.location.hash || "#main", preferredLink = null) {
      [primaryNav, mobileNav, sidebarNav].forEach(container => {
        const links = [...container.querySelectorAll("a[href]")];
        const matchingLinks = links.filter(link => {
          const href = link.getAttribute("href");
          if (href === target) return true;

          const destination = new URL(href, window.location.href);
          if (target.startsWith("#")) return destination.hash === target;
          if (target.includes("#")) {
            const targetUrl = new URL(target, window.location.href);
            return destination.pathname === targetUrl.pathname && destination.hash === targetUrl.hash;
          }
          return destination.pathname === target && !destination.hash;
        });
        const activeLink = matchingLinks.find(link => link === preferredLink) ||
          matchingLinks.find(link => link.parentElement === container) || matchingLinks[0];

        links.forEach(link => {
          if (link === activeLink) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });

        container.querySelectorAll("details").forEach(group => {
          const summary = group.querySelector("summary");
          if (group.querySelector('[aria-current="page"]')) summary.setAttribute("aria-current", "page");
          else summary.removeAttribute("aria-current");
        });
      });
    }

    async function loadNavigation() {
      const endpoint = document.body.dataset.navigationApi;
      if (!endpoint || window.location.protocol === "file:") return fallbackConfig;

      try {
        const response = await fetch(endpoint, { headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Navigation API request failed");
        const data = await response.json();
        if (!isNavigationConfig(data)) {
          console.error("Navigation API returned invalid menu data; using the built-in menu.");
          return fallbackConfig;
        }
        return data;
      } catch (error) {
        console.error("Could not load menu data from the navigation API; using the built-in menu.", error);
        return fallbackConfig;
      }
    }

    renderNavigation(fallbackConfig);
    loadNavigation().then(renderNavigation);
    let clickedNavigationLink = null;
    window.addEventListener("hashchange", () => {
      const target = window.location.hash || "#main";
      clickedNavigationLink = clickedNavigationLink && clickedNavigationLink.getAttribute("href") === target
        ? clickedNavigationLink
        : null;
      updateActiveLinks(target, clickedNavigationLink);
    });
    document.addEventListener("click", event => {
      const link = event.target.closest("a[href]");
      if (!link || ![primaryNav, mobileNav, sidebarNav].some(container => container.contains(link))) return;

      clickedNavigationLink = link;
      updateActiveLinks(link.getAttribute("href"), clickedNavigationLink);
      if (mobileNav.contains(link)) drawerToggle.checked = false;
    });
    try {
      aboutCopy.value = localStorage.getItem(aboutStorageKey) || "";
    } catch {
      aboutSaveStatus.textContent = "Text storage is unavailable in this browser.";
    }
    aboutCopy.addEventListener("input", () => {
      try {
        localStorage.setItem(aboutStorageKey, aboutCopy.value);
        aboutSaveStatus.textContent = "Saved on this device.";
      } catch {
        aboutSaveStatus.textContent = "Unable to save in this browser.";
      }
    });

    function isStoredReview(value) {
      return value && Number.isInteger(value.rating) && value.rating >= 1 && value.rating <= 5 &&
        typeof value.text === "string" && value.text.length <= 500 &&
        typeof value.createdAt === "string" && Number.isFinite(Date.parse(value.createdAt));
    }

    function readStoredReviews() {
      const stored = localStorage.getItem(reviewStorageKey);
      if (stored === null) return [];

      const parsed = JSON.parse(stored);
      if (!Array.isArray(parsed) || !parsed.every(isStoredReview)) {
        throw new Error("Saved review data has an invalid format.");
      }
      return parsed;
    }

    function renderReviews() {
      const total = savedReviews.reduce((sum, review) => sum + review.rating, 0);
      const average = savedReviews.length ? total / savedReviews.length : 0;
      const roundedAverage = Math.round(average);
      reviewAverage.textContent = savedReviews.length ? average.toFixed(1) : "—";
      reviewStars.textContent = `${"★".repeat(roundedAverage)}${"☆".repeat(5 - roundedAverage)}`;
      reviewStars.setAttribute("aria-label", savedReviews.length
        ? `${average.toFixed(1)} out of 5 stars`
        : "No ratings yet");
      reviewCount.textContent = savedReviews.length
        ? `${savedReviews.length} ${savedReviews.length === 1 ? "review" : "reviews"}`
        : "Be the first to rate Wayfinder.";
      reviewList.replaceChildren();

      savedReviews.forEach(review => {
        const card = document.createElement("article");
        card.className = "review-card";
        card.setAttribute("role", "listitem");

        const header = document.createElement("header");
        const title = document.createElement("h3");
        title.textContent = `${reviewRatings[review.rating].emoji} ${reviewRatings[review.rating].label} · ${review.rating}/5`;
        const date = document.createElement("time");
        date.dateTime = review.createdAt;
        date.textContent = new Date(review.createdAt).toLocaleDateString();
        header.append(title, date);
        card.append(header);

        if (review.text) {
          const note = document.createElement("p");
          note.textContent = review.text;
          card.append(note);
        }
        reviewList.append(card);
      });
    }

    try {
      savedReviews = readStoredReviews();
      renderReviews();
    } catch (error) {
      console.error("Could not load saved reviews.", error);
      reviewStorageReady = false;
      reviewStatus.textContent = "Saved reviews could not be loaded. Your browser's saved review data may be invalid or unavailable.";
      reviewForm.querySelector("button[type='submit']").disabled = true;
    }

    reviewForm.querySelectorAll("input[name='rating']").forEach(input => {
      input.addEventListener("change", event => {
        const rating = Number(event.currentTarget.value);
        ratingFeedback.textContent = `You chose ${reviewRatings[rating].label.toLowerCase()} (${rating} out of 5).`;
      });
    });

    reviewForm.addEventListener("submit", event => {
      event.preventDefault();
      if (!reviewStorageReady) return;

      const rating = Number(new FormData(reviewForm).get("rating"));
      if (!Number.isInteger(rating) || !reviewRatings[rating]) {
        ratingFeedback.textContent = "Choose an emoji rating before sharing your review.";
        return;
      }

      const review = {
        rating,
        text: reviewText.value.trim(),
        createdAt: new Date().toISOString()
      };
      const updatedReviews = [review, ...savedReviews];
      try {
        localStorage.setItem(reviewStorageKey, JSON.stringify(updatedReviews));
      } catch (error) {
        console.error("Could not save your review.", error);
        reviewStatus.textContent = "Your review could not be saved in this browser. Check available storage and try again.";
        return;
      }

      savedReviews = updatedReviews;
      renderReviews();
      reviewForm.reset();
      ratingFeedback.textContent = "Click an emoji to choose your rating.";
      reviewStatus.textContent = "Thank you — your review is saved on this device.";
    });
  </script>
  <footer>Wayfinder — a friendly starting point for the web</footer>
</body>
