                  <span class="rating-emoji" aria-hidden="true">😐</span><span class="rating-label">Just okay</span>
                </label>
                <label class="rating-choice" for="rating-3">
                  <input id="rating-3" type="radio" name="rating" value="3" required>
                  <span class="rating-emoji" aria-hidden="true">🙂</span><span class="rating-label">Good</span>
                </label>
                <label class="rating-choice" for="rating-4">
                  <input id="rating-4" type="radio" name="rating" value="4" required>
                  <span class="rating-emoji" aria-hidden="true">😄</span><span class="rating-label">Great</span>
                </label>
                <label class="rating-choice" for="rating-5">
                  <input id="rating-5" type="radio" name="rating" value="5" required>
                  <span class="rating-emoji" aria-hidden="true">🤩</span><span class="rating-label">Loved it</span>
