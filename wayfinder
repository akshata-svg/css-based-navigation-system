      .tabs { container-type: inline-size; container-name: tabs; }
      .tab-labels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; border-bottom: 1px solid var(--border-color); }
      .tab-labels a { position: relative; padding: 10px 12px; color: var(--muted-color); text-align: center; border-radius: 8px 8px 0 0; }
      .tab-labels a::after { position: absolute; right: 12px; bottom: -1px; left: 12px; height: 2px; content: ""; background: var(--primary-color); scale: 0 1; transition: scale .18s ease; }
      .tab-labels a:target,
      .tab-labels a[aria-current="page"] { color: var(--primary-color); }
      .tab-labels a:target::after,
      .tab-labels a[aria-current="page"]::after { scale: 1 1; }
      .tab-viewport {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 100%;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
