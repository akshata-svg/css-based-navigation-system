      .breadcrumb-trail { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
      .breadcrumb-trail li + li::before { content: "›"; margin-right: 8px; color: var(--accent-color); font-weight: 800; }
      .breadcrumb-trail a { color: var(--primary-color); }
      .breadcrumb-jump { position: relative; }
      .breadcrumbs [aria-current="page"] { color: var(--text-color); font-weight: 700; }
      pre { max-width: 100%; overflow-x: auto; padding: 14px; color: #f4f1e8; background: #292c27; border-radius: 12px; font-size: 13px; }
    }

    @layer states {
      .skip-link:focus { top: 8px; }
      :where(a, button, input, summary):focus-visible { outline: 3px solid #e0b84f; outline-offset: 3px; }
      .nav-links > a, .mobile-drawer > a { border-bottom: 2px solid transparent; }
      .nav-links > a[aria-current="page"],
      .mobile-drawer > a[aria-current="page"] {
        color: var(--primary-color);
        background: var(--hover-color);
        border-color: var(--primary-color);
      }
      .nav-dropdown > summary[aria-current="page"] {
        color: var(--primary-color);
      }
      .dropdown-menu a[aria-current="page"],
      .sidebar a[aria-current="page"] { color: var(--primary-color); background: var(--hover-color); }
      .nav-links a:hover, .nav-dropdown > summary:hover,
      .sample-navbar a:hover, .sample-navbar summary:hover { color: var(--primary-color); }
      .hero-link { transition: transform .18s ease, background .18s ease; }
      .hero-link:hover { color: #fffdf8; background: #a95225; transform: translateY(-2px); }
      .feature-card:hover { box-shadow: 0 12px 24px #25282012; transform: translateY(-3px); }
      .intro { animation: welcome-in .65s ease-out both; }
      .hero-copy > * { animation: welcome-in .55s ease-out both; }
      .hero-copy > :nth-child(1) { animation-delay: .08s; }
      .hero-copy > :nth-child(2) { animation-delay: .16s; }
      .hero-copy > :nth-child(3) { animation-delay: .24s; }
      .hero-copy > :nth-child(4) { animation-delay: .32s; }
      .route-card { animation: card-float 5s ease-in-out infinite; }
      .route-pin { animation: pin-pulse 2.4s ease-in-out infinite; }
      .panel { animation: panel-arrive .55s ease-out both; }
      .visual-browser-nav details[open] > .visual-dropdown-menu a,
      .visual-browser-nav details:hover > .visual-dropdown-menu a,
      .visual-browser-nav details:focus-within > .visual-dropdown-menu a,
      .visual-browser-nav .visual-mega-menu[open] .visual-mega-links a,
      .visual-browser-nav .visual-mega-menu:hover .visual-mega-links a,
      .visual-browser-nav .visual-mega-menu:focus-within .visual-mega-links a { animation: menu-item-arrive .32s ease-out both; }
      .visual-dropdown-menu a:nth-child(2), .visual-mega-links a:nth-of-type(3) { animation-delay: .04s; }
      .visual-dropdown-menu a:nth-child(3), .visual-mega-links a:nth-of-type(4) { animation-delay: .08s; }
      .visual-dropdown-menu a:nth-child(4) { animation-delay: .12s; }
      .component-list > .panel:nth-child(2) { animation-delay: .06s; }
      .component-list > .panel:nth-child(3) { animation-delay: .12s; }
      .component-list > .panel:nth-child(4) { animation-delay: .18s; }
      .component-list > .panel:nth-child(5) { animation-delay: .24s; }
      .component-list > .panel:nth-child(6) { animation-delay: .3s; }
      .component-list > .panel:nth-child(7) { animation-delay: .36s; }
      @keyframes welcome-in {
        from { opacity: 0; translate: 0 14px; }
        to { opacity: 1; translate: 0 0; }
      }
      @keyframes pin-bob {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -7px; }
      }
      @keyframes panel-arrive {
        from { opacity: 0; translate: 0 10px; }
        to { opacity: 1; translate: 0 0; }
      }
      @keyframes card-float {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -7px; }
      }
      @keyframes pin-pulse {
        0%, 100% { box-shadow: 0 5px 14px #25282030; }
        50% { box-shadow: 0 7px 22px #2528204a, 0 0 0 8px #c5693033; }
      }
      @keyframes menu-item-arrive {
        from { opacity: 0; translate: 0 5px; }
        to { opacity: 1; translate: 0 0; }
      }
      @keyframes menu-route { to { stroke-dashoffset: -44; } }
      @keyframes menu-destination {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.16); }
      }
      .dropdown-menu a:hover, .sidebar a:hover, .tabs label:hover { background: var(--hover-color); border-radius: 8px; }
      .sidebar a:hover { color: var(--primary-color); }
      .breadcrumbs a:hover, .breadcrumb-menu a:hover { color: var(--primary-color); text-decoration: underline; }
      .link-category a:hover { color: var(--accent-color); text-decoration: underline; }
      .button:hover { color: white; background: #344c38; }
      .nav-dropdown[open] > .dropdown-menu,
      .nav-dropdown:hover > .dropdown-menu,
      .nav-dropdown:focus-within > .dropdown-menu,
      .sample-dropdown[open] > .dropdown-menu,
      .sample-dropdown:hover > .dropdown-menu,
      .sample-dropdown:focus-within > .dropdown-menu {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
        visibility: visible;
      }
      .nav-links [aria-current="page"] { view-transition-name: nav-active-page; }
      ::view-transition-group(nav-active-page) { animation-duration: .22s; }
      @keyframes popover-arrive {
        from { opacity: 0; transform: translateY(6px) scale(.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
    }

