<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Wayfinder is a friendly, responsive starting point for finding useful websites and navigating the web.">
  <title>Wayfinder — Find your way around the web</title>
  <style>
    @layer reset, tokens, layout, components, states, responsive;

    @layer reset {
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      a { color: inherit; text-decoration: none; }
      summary { cursor: pointer; list-style: none; }
      summary::-webkit-details-marker { display: none; }
    }

    @layer tokens {
      :root {
        --primary-color: #29483a;
        --hover-color: #e7ece1;
        --text-color: #252820;
        --muted-color: #6b6d62;
        --border-color: #e3d8bd;
        --page-color: #f6f1e4;
        --surface-color: #fffaf0;
        --accent-color: #b86f3e;
      }
    }

    @layer layout {
      body {
        color: var(--text-color);
        background: var(--page-color);
        font: 16px/1.5 system-ui, sans-serif;
      }

      main {
        width: min(1080px, 100% - 48px);
        margin: auto;
        padding: 36px 0 56px;
      }
      .panel[id] { scroll-margin-top: 80px; }
      .link-category[id] { scroll-margin-top: 84px; }

      .opening-page {
        position: relative;
        isolation: isolate;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        overflow: hidden;
        padding: 0 clamp(20px, 6vw, 88px);
        color: #f7f1df;
        background:
          radial-gradient(ellipse at 84% 13%, #caa65728, transparent 28rem),
          radial-gradient(ellipse at 8% 94%, #bf70452b, transparent 30rem),
          linear-gradient(135deg, #19372f, #24463a 58%, #1c3c33);
      }
      .opening-page::before {
        position: absolute;
        top: 10%;
        right: -200px;
        z-index: -1;
        width: 420px;
        height: 420px;
        content: "";
        background: repeating-conic-gradient(from 15deg, #d7b6680a 0 12deg, transparent 12deg 24deg);
        border: 1px solid #d7b6682b;
        border-radius: 50%;
      }
      .opening-topbar, .opening-layout, .opening-footer { width: min(1120px, 100%); margin: 0 auto; }
      .opening-topbar { min-height: 76px; display: flex; align-items: center; justify-content: space-between; }
      .opening-brand { display: inline-flex; align-items: center; gap: 10px; color: #f4ecd5; font-size: 19px; font-weight: 850; letter-spacing: -.04em; }
      .opening-mark { width: 34px; height: 34px; display: grid; place-items: center; color: #1d392f; background: #d7b668; border-radius: 11px; }
      .opening-note { color: #d6cfba; font-size: 13px; font-weight: 650; letter-spacing: .04em; }
      .opening-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(270px, .85fr); gap: clamp(24px, 7vw, 84px); align-items: center; padding: 20px 0 42px; }
      .opening-copy { max-width: 610px; animation: welcome-in .7s both; }
      .opening-eyebrow { display: inline-block; margin-bottom: 18px; padding: 7px 12px; color: #eddfb6; background: #ffffff0b; border: 1px solid #d7b66865; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
      .opening-copy h1 { max-width: 620px; margin: 0; color: #fff8e9; font-size: clamp(46px, 7.5vw, 82px); line-height: .99; letter-spacing: -.065em; }
      .opening-copy p { max-width: 500px; margin: 22px 0 28px; color: #dedccf; font-size: clamp(17px, 2vw, 20px); }
      .locate-link { min-height: 58px; display: inline-flex; align-items: center; gap: 13px; padding: 8px 19px 8px 9px; color: #1e392f; background: #d7b668; border: 2px solid #d7b668; border-radius: 15px; box-shadow: 0 10px 26px #070d0b4a; font: inherit; font-weight: 800; cursor: pointer; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
      .locate-link:hover { background: #e3c77a; border-color: #e3c77a; box-shadow: 0 14px 30px #070d0b55; transform: translateY(-3px); }
      .locate-icon { width: 40px; height: 40px; display: grid; place-items: center; color: #e3c77a; background: #24463a; border-radius: 12px; }
      .locate-icon svg { width: 22px; height: 22px; }
      .opening-hint { display: block; margin-top: 11px; color: #c9c4b3; font-size: 12px; }
      .opening-art { position: relative; min-height: 340px; display: grid; place-items: center; animation: welcome-in .85s .12s both; }
      .opening-map { position: relative; width: min(100%, 350px); min-height: 285px; overflow: hidden; background-color: #f5eedb; background-image: linear-gradient(34deg, transparent 46%, #b8c5a9 47%, #b8c5a9 49%, transparent 50%), linear-gradient(145deg, transparent 47%, #d8c79e 48%, #d8c79e 50%, transparent 51%), repeating-linear-gradient(45deg, transparent 0 18px, #b9974f10 18px 20px); background-size: 95px 82px, 115px 104px, 32px 32px; border: 9px solid #f7f0df; border-radius: 28px; box-shadow: 0 30px 65px #050d0a55, 0 4px 12px #050d0a30; transform: rotate(3deg); }
      .opening-map-label { position: absolute; top: 16px; left: 16px; z-index: 1; padding: 7px 10px; color: #284638; background: #fff9e9ed; border: 1px solid #d7c89f; border-radius: 999px; font-size: 11px; font-weight: 800; }
      .opening-route { position: absolute; inset: 18% 10%; width: 80%; height: 68%; overflow: visible; }
      .opening-route path { stroke-dasharray: 4 11; animation: route-draw 2s ease-out both; }
      .opening-pin { position: absolute; top: 43%; right: 23%; width: 52px; height: 52px; display: grid; place-items: center; color: white; background: #bd6942; border: 5px solid #fff9e9; border-radius: 50% 50% 50% 8px; box-shadow: 0 8px 18px #25282030; transform: rotate(-45deg); animation: pin-pulse 2.4s ease-in-out infinite; }
      .opening-pin span { transform: rotate(45deg); font-size: 16px; }
      .opening-footer { padding: 17px 0 22px; display: flex; justify-content: space-between; gap: 16px; color: #c9c4b3; border-top: 1px solid #d7b66845; font-size: 12px; }
      .opening-footer strong { color: #e0c47a; }

      .intro {
        position: relative;
        isolation: isolate;
        min-height: 410px;
        margin-bottom: 36px;
        padding: clamp(28px, 6vw, 64px);
        overflow: hidden;
        color: #fffdf8;
        background:
          radial-gradient(ellipse at 68% 0%, #c4a45630, transparent 38%),
          linear-gradient(118deg, #19372f 0%, #29483a 68%, #365646 100%);
        border: 1px solid #d4b7686b;
        border-radius: 24px;
        box-shadow: 0 18px 42px #2528201c;
      }
      .intro::after {
        position: absolute;
        top: -180px;
        right: 24%;
        z-index: -1;
        width: 420px;
        height: 420px;
        content: "";
        background: linear-gradient(140deg, #e2c36d, #b86f3e);
        border-radius: 50%;
        opacity: .2;
        transform: rotate(-18deg);
      }
      .hero-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .82fr); gap: clamp(24px, 5vw, 56px); align-items: center; }
      .hero-copy { max-width: 570px; }
      .eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        padding: 6px 12px;
        color: #fffdf8;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        background: #ffffff12;
        border: 1px solid #ffffff38;
        border-radius: 999px;
      }
      .intro h1 { max-width: 650px; margin: 0 0 12px; font-size: clamp(38px, 6vw, 64px); line-height: 1.04; letter-spacing: -.04em; }
      .intro p { max-width: 570px; margin: 0 0 24px; color: #e7e9df; font-size: clamp(16px, 2vw, 19px); }
      .hero-link { display: inline-flex; padding: 11px 17px; color: #fffdf8; font-weight: 700; background: var(--accent-color); border-radius: 10px; }
      .welcome-art { position: relative; min-height: 290px; display: grid; place-items: center; }
      .route-card { position: relative; width: min(100%, 350px); min-height: 260px; padding: 20px; overflow: hidden; color: var(--text-color); background: #fff8e8; border: 1px solid #d4b76880; border-radius: 22px; box-shadow: 0 22px 50px #101a1645; transform: rotate(2deg); }
      .route-card::before { position: absolute; inset: 45px 24px 24px; content: ""; background-image: linear-gradient(30deg, transparent 48%, #d9e3d3 49%, #d9e3d3 51%, transparent 52%), linear-gradient(150deg, transparent 48%, #e8dfc7 49%, #e8dfc7 51%, transparent 52%), repeating-linear-gradient(45deg, transparent 0 15px, #b9974f10 15px 17px); background-size: 64px 56px, 72px 64px, 30px 30px; opacity: .8; }
      .route-card-top, .route-label, .route-pin, .route-path { position: relative; z-index: 1; }
      .route-card-top { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 800; }
      .route-dot { width: 9px; height: 9px; display: inline-block; margin-right: 7px; background: var(--accent-color); border-radius: 50%; box-shadow: 0 0 0 5px #b86f3e24; }
      .route-label { position: absolute; top: 72px; left: 24px; padding: 5px 9px; color: #49624b; background: #e9eee5; border-radius: 999px; font-size: 11px; font-weight: 700; }
      .route-path { position: absolute; inset: 92px 20px 20px; width: calc(100% - 40px); height: calc(100% - 112px); overflow: visible; }
      .route-pin { position: absolute; top: 142px; right: 68px; width: 34px; height: 34px; display: grid; place-items: center; color: white; background: var(--accent-color); border: 4px solid white; border-radius: 50% 50% 50% 0; box-shadow: 0 5px 14px #25282030; transform: rotate(-45deg); }
      .route-pin span { transform: rotate(45deg); font-size: 12px; }
      .route-footer { position: absolute; right: 20px; bottom: 18px; left: 20px; z-index: 1; display: flex; justify-content: space-between; color: var(--muted-color); font-size: 11px; }
      .about-overview { display: grid; gap: 16px; }
      .about-overview > p { margin: 0; color: var(--muted-color); }
      .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
      .feature-card { padding: 14px; background: linear-gradient(145deg, var(--surface-color), #f5f2e9); border: 1px solid var(--border-color); border-radius: 12px; transition: transform .18s ease, box-shadow .18s ease; }
      .feature-card h3 { margin: 0 0 5px; color: var(--primary-color); font-size: 15px; }
      .feature-card p { margin: 0; color: var(--muted-color); font-size: 13px; }
      .about-editor { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border-color); }
      .content-grid { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 24px; align-items: start; }
      .component-list { min-width: 0; }
      footer { padding: 24px; text-align: center; color: var(--muted-color); border-top: 1px solid var(--border-color); }
    }

    @layer components {
      .skip-link { position: absolute; top: -50px; left: 12px; z-index: 20; padding: 8px; background: var(--surface-color); }
      .navbar {
        position: sticky;
        top: 0;
        z-index: 10;
        min-height: 64px;
        padding: 0 3%;
        display: flex;
        align-items: center;
        gap: 16px;
        background: #fffdf8ed;
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-color);
      }
      .site-name { margin-right: auto; color: var(--primary-color); font-size: 19px; font-weight: 800; letter-spacing: -.04em; }
      .site-name::before { content: "✦ "; color: var(--accent-color); }
      .nav-links { display: flex; align-items: center; gap: 14px; }
      .nav-links > a, .nav-dropdown > summary { padding: 10px 8px; color: var(--muted-color); border-radius: 8px; }
      .nav-dropdown { position: relative; }
      .nav-dropdown > summary::after { content: " ▾"; }
      .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 5;
        width: 210px;
        padding: 8px;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 8px 20px #25282014;
        opacity: 0;
        pointer-events: none;
        transform: translateY(6px);
        visibility: hidden;
        transition: opacity .16s ease, transform .16s ease, visibility .16s ease;
      }
      .dropdown-menu ul { margin: 0; padding: 0; list-style: none; }
      .dropdown-menu li > a, .dropdown-menu > a { display: block; padding: 10px; border-radius: 8px; }
      .dropdown-menu .menu-group > h3 { margin: 6px 8px 3px; color: var(--primary-color); font-size: 12px; }
      .dropdown-menu .menu-group > ul > li > a { padding: 7px 8px; }
      .mega-menu { left: auto; right: -80px; width: min(600px, 90vw); padding: 20px; }
      .mega-menu h2 { margin: 0 0 12px; color: var(--primary-color); font-size: 18px; }
      .mega-menu > ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
      .mega-menu .menu-group > h3 { margin: 0 0 6px; color: var(--primary-color); font-size: 14px; }
      .mega-menu .menu-group > ul > li > a { padding: 7px 8px; }
      .breadcrumb-dropdown { position: relative; }
      .breadcrumb-dropdown > summary { padding: 3px 8px; color: var(--primary-color); border: 1px solid var(--border-color); border-radius: 8px; }
      .breadcrumb-dropdown > summary::after { content: " ▾"; }
      .breadcrumb-menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 6; width: 190px; max-height: 260px; display: grid; gap: 2px; overflow-y: auto; padding: 7px; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 10px 24px #2528201c; opacity: 0; pointer-events: none; transform: translateY(5px); visibility: hidden; transition: opacity .16s ease, transform .16s ease, visibility .16s ease; }
      .breadcrumb-menu a { padding: 8px 9px; color: var(--muted-color); border-radius: 7px; }
      .breadcrumb-dropdown[open] > .breadcrumb-menu, .breadcrumb-dropdown:hover > .breadcrumb-menu, .breadcrumb-dropdown:focus-within > .breadcrumb-menu { opacity: 1; pointer-events: auto; transform: translateY(0); visibility: visible; }
      .button { padding: 10px 16px; color: white; font-weight: 700; background: var(--primary-color); border-radius: 10px; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

      .drawer-toggle, .menu-button, .mobile-drawer, .drawer-backdrop { display: none; }
      .menu-button span { width: 20px; height: 2px; background: var(--text-color); }
      .drawer-toggle:focus-visible + .menu-button { outline: 3px solid #e0b84f; outline-offset: 3px; }

      .sidebar, .panel {
        padding: 18px;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 6px 20px #25282008;
      }
      .sidebar h2 { margin: 0 0 10px; font-size: 14px; }
      .sidebar a { display: block; padding: 8px; color: var(--muted-color); }
      .panel { margin-bottom: 20px; }
      .panel h2 { margin: 0 0 14px; padding-bottom: 10px; color: #29483a; border-bottom: 1px solid var(--border-color); font-size: 19px; }
      .about-editor { display: grid; gap: 8px; }
      .about-editor label { font-weight: 600; }
      .about-editor textarea { width: 100%; min-height: 120px; padding: 12px; color: var(--text-color); font: inherit; border: 1px solid var(--border-color); resize: vertical; }
      .about-editor textarea:focus { outline: 2px solid var(--primary-color); outline-offset: 2px; }
      .about-editor p { margin: 0; color: var(--muted-color); font-size: 13px; }
      .review-intro { margin: 0 0 16px; color: var(--muted-color); }
      .review-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 18px; padding: 14px 16px; background: linear-gradient(110deg, #f8f0db, #fffaf0); border: 1px solid var(--border-color); border-radius: 12px; }
      .review-average { color: var(--primary-color); font-size: 27px; font-weight: 850; line-height: 1; }
      .review-stars { color: #b78332; letter-spacing: .12em; }
      .review-count { color: var(--muted-color); font-size: 13px; }
      .review-form { display: grid; gap: 12px; }
      .emoji-rating { margin: 0; padding: 0; border: 0; }
      .emoji-rating legend, .review-form label[for="review-text"] { margin-bottom: 8px; color: var(--text-color); font-weight: 700; }
      .rating-options { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
      .rating-choice { position: relative; min-width: 0; display: grid; justify-items: center; gap: 6px; padding: 12px 6px; color: var(--muted-color); background: #fffdf8; border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: background .16s ease, border-color .16s ease, transform .16s ease; }
      .rating-choice:hover { background: #f8f0db; transform: translateY(-2px); }
      .rating-choice:has(input:checked) { color: var(--primary-color); background: #e9eee5; border-color: var(--primary-color); box-shadow: 0 0 0 2px #29483a18; }
      .rating-choice input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
      .rating-choice input:focus-visible + .rating-emoji { outline: 3px solid #e0b84f; outline-offset: 3px; border-radius: 8px; }
      .rating-emoji { font-size: 27px; line-height: 1.1; transition: transform .16s ease; }
      .rating-choice:has(input:checked) .rating-emoji { transform: scale(1.2); }
      .rating-label { font-size: 11px; font-weight: 650; text-align: center; }
      .review-form textarea { width: 100%; min-height: 92px; padding: 12px; color: var(--text-color); font: inherit; border: 1px solid var(--border-color); border-radius: 10px; resize: vertical; }
      .review-form textarea:focus { outline: 2px solid var(--primary-color); outline-offset: 2px; }
      .review-hint, .review-status { margin: 0; color: var(--muted-color); font-size: 13px; }
      .review-submit { justify-self: start; padding: 10px 16px; color: #fffaf0; background: var(--primary-color); border: 0; border-radius: 10px; font: inherit; font-weight: 750; cursor: pointer; transition: background .16s ease, transform .16s ease; }
      .review-submit:hover { background: #19372f; transform: translateY(-1px); }
      .review-list { display: grid; gap: 10px; margin-top: 20px; }
      .review-card { padding: 14px 16px; background: linear-gradient(145deg, #fffdf8, #f8f0db); border: 1px solid var(--border-color); border-radius: 12px; }
      .review-card header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
      .review-card h3, .review-card p { margin: 0; }
      .review-card h3 { color: var(--primary-color); font-size: 15px; }
      .review-card time { color: var(--muted-color); font-size: 12px; }
      .review-card p { color: var(--text-color); white-space: pre-wrap; overflow-wrap: anywhere; }
      .contact-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
      .contact-card { padding: 14px; background: linear-gradient(145deg, var(--surface-color), #f5f2e9); border: 1px solid var(--border-color); border-radius: 12px; }
      .contact-card h3 { margin: 0 0 8px; font-size: 16px; }
      .contact-card p, .contact-card address { margin: 4px 0; color: var(--muted-color); font-size: 14px; font-style: normal; }
      .contact-card a { color: var(--primary-color); }
      .link-directory { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; }
      .link-category { padding: 16px; background: linear-gradient(145deg, var(--surface-color), #f5f2e9); border: 1px solid var(--border-color); border-radius: 12px; }
      .link-category h3 { margin: 0 0 10px; color: #354b37; font-size: 16px; }
      .link-category ul { margin: 0; padding: 0; list-style: none; }
      .link-category li + li { margin-top: 6px; }
      .link-category a { color: var(--primary-color); font-weight: 600; }
      .sample-navbar {
        padding: 12px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        border: 1px solid var(--border-color);
      }
      .sample-navbar > strong { margin-right: auto; }
      .sample-navbar a, .sample-navbar summary { color: var(--muted-color); }
      .sample-dropdown { position: relative; }
      .sample-dropdown > summary::after { content: " ▾"; }
      .sample-dropdown .dropdown-menu { top: 24px; }
      .menu-visuals { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr)); gap: 14px; margin-top: 18px; }
      .menu-visual-card { min-width: 0; padding: 14px; background: linear-gradient(145deg, #fffdf8, #f8f0db); border: 1px solid var(--border-color); border-radius: 14px; }
      .menu-visual-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
      .menu-visual-icon { width: 40px; height: 40px; display: grid; place-items: center; color: #fff9e9; background: var(--primary-color); border-radius: 12px; font-size: 19px; }
      .menu-visual-heading h3, .menu-visual-heading p { margin: 0; }
      .menu-visual-heading h3 { color: var(--primary-color); font-size: 15px; }
      .menu-visual-heading p, .menu-visual-caption { color: var(--muted-color); font-size: 12px; }
      .visual-browser { position: relative; padding: 8px; overflow: visible; background: #fffdf8; border: 1px solid #e6decb; border-radius: 12px; box-shadow: 0 7px 18px #2528200c; }
      .visual-browser-chrome { height: 22px; display: flex; align-items: center; gap: 4px; padding: 0 2px 6px; color: #77786f; font-size: 9px; }
      .visual-browser-chrome span:nth-child(4) { margin: 0 auto; padding: 2px 14px; background: #f3efe4; border-radius: 999px; }
      .visual-browser-chrome i { width: 6px; height: 6px; background: #d28d69; border-radius: 50%; }
      .visual-browser-chrome i:nth-child(2) { background: #e0bd68; }
      .visual-browser-chrome i:nth-child(3) { background: #829577; }
      .visual-browser-nav { position: relative; min-height: 34px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 5px 7px; color: #58675d; border-bottom: 1px solid #eee8db; font-size: 10px; }
      .visual-browser-nav > strong { margin-right: auto; color: var(--primary-color); font-size: 10px; letter-spacing: .06em; }
      .visual-browser-nav a, .visual-browser-nav summary { padding: 3px 4px; }
      .visual-browser-nav details { position: relative; }
      .visual-browser-nav summary::after { content: "⌄"; margin-left: 3px; }
